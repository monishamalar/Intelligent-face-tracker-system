{
  "system": {
    "app_name": "Intelligent Face Tracker",
    "version": "1.0.0",
    "device": "auto"
  },
  "input": {
    "source": "sample/sample_walkthrough.mp4",
    "source_type": "video",
    "rtsp_reconnect_interval_sec": 5,
    "max_reconnect_attempts": 10
  },
  "detection": {
    "model_name": "yolov8n-face",
    "confidence_threshold": 0.55,
    "frame_skip": 5,
    "min_face_size": [60, 60],
    "iou_threshold": 0.45
  },
  "recognition": {
    "model_name": "buffalo_l",
    "embedding_dimension": 512,
    "similarity_threshold": 0.45,
    "distance_metric": "cosine",
    "max_gallery_embeddings_per_face": 5
  },
  "tracking": {
    "tracker": "bytetrack",
    "track_thresh": 0.5,
    "track_buffer": 30,
    "match_thresh": 0.8,
    "exit_timeout_frames": 30,
    "exit_timeout_seconds": 2.0
  },
  "storage": {
    "base_dir": "logs",
    "entries_dir": "logs/entries",
    "exits_dir": "logs/exits",
    "registrations_dir": "logs/registrations",
    "save_crop_margin_pct": 0.15
  },
  "database": {
    "sqlite_path": "visitor_tracker.db",
    "echo_sql": false
  },
  "logging": {
    "log_file": "logs/events.log",
    "log_level": "INFO",
    "console_output": true,
    "max_bytes": 10485760,
    "backup_count": 5
  }
}
